generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                String             @id @default(uuid())
  name              String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  users             User[]
  organizationUnits OrganizationUnit[]
  documents         Document[]
  auditLogs         AuditLog[]
}

model OrganizationUnit {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  users          User[]
  documents      Document[]
}

// ── NEW: Department Reference Table ─────────────────────────────────────────
model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

// ── NEW: Jabatan (Position) Reference Table ──────────────────────────────────
model Jabatan {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  User            User[]
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  fullName         String
  jobTitle         String?
  phone            String?           // ── NEW
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  unitId           String?
  unit             OrganizationUnit? @relation(fields: [unitId], references: [id])
  departmentId     String?           // ── NEW
  department       Department?       @relation(fields: [departmentId], references: [id])
  jabatanId        String?           // ── NEW
  jabatan          Jabatan?          @relation(fields: [jabatanId], references: [id])
  roleId           String
  role             Role              @relation(fields: [roleId], references: [id])
  userRoles        UserRole[]
  isActive         Boolean           @default(true)
  twoFactorEnabled Boolean           @default(false)
  twoFactorSecret  String?
  pinHash          String?
  pushToken        String?           // ── NEW: For Push Notifications
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  documentsCreated Document[]        @relation("DocumentCreator")
  workflowSteps    DocumentWorkflowStep[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  signatures       DocumentSignature[]
  biometrics       UserBiometric[]
  disposisiLogs    DisposisiLog[]
  evidenceFiles    EvidenceFile[]
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model DocumentCategory {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  documents Document[]
}

model DocumentClassification {
  id        String     @id @default(uuid())
  level     String     @unique
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  documents Document[]
}

model Document {
  id                String                   @id @default(uuid())
  title             String
  documentNumber    String?                  @unique
  organizationId    String
  organization      Organization             @relation(fields: [organizationId], references: [id])
  unitId            String?
  unit              OrganizationUnit?        @relation(fields: [unitId], references: [id])
  categoryId        String
  category          DocumentCategory         @relation(fields: [categoryId], references: [id])
  subCategory       String?
  classificationId  String
  classification    DocumentClassification   @relation(fields: [classificationId], references: [id])
  creatorId         String
  creator           User                     @relation("DocumentCreator", fields: [creatorId], references: [id])
  documentType      String                   @default("OUTGOING")
  approvalFlowType  String                   @default("SEQUENTIAL")
  certificateUrl    String?
  status            String                   @default("DRAFT")
  disposisiStatus   String?                  // "BARU", "DIPROSES", "SELESAI"
  currentVersion    Int                      @default(1)
  documentDate      DateTime?
  receivedDate      DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  versions          DocumentVersion[]
  workflowInstances DocumentWorkflowInstance[]
  signatures        DocumentSignature[]
  publications      DocumentPublication[]
  disposisiLogs     DisposisiLog[]
  evidenceFolders   EvidenceFolder[]
  evidenceFiles     EvidenceFile[]
  meetings          Meeting[]
  discussedInMeetings Meeting[] @relation("MeetingDiscussedDocs")
  publicSubmissions PublicSubmission[]
}

model DocumentVersion {
  id          String   @id @default(uuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id])
  versionNum  Int
  fileUrl     String
  fileName    String
  fileSize    Int
  mimeType    String
  changeNotes String?
  createdAt   DateTime @default(now())
  createdBy   String

  @@unique([documentId, versionNum])
}

model WorkflowTemplate {
  id                String                     @id @default(uuid())
  name              String
  description       String?
  organizationId    String
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  steps             Json
  workflowInstances DocumentWorkflowInstance[]
}

model DocumentWorkflowInstance {
  id            String                 @id @default(uuid())
  documentId    String
  document      Document               @relation(fields: [documentId], references: [id])
  templateId    String?
  template      WorkflowTemplate?      @relation(fields: [templateId], references: [id])
  status        String                 @default("ACTIVE")
  currentStep   Int                    @default(1)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  steps         DocumentWorkflowStep[]
}

model DocumentWorkflowStep {
  id                 String                   @id @default(uuid())
  workflowInstanceId String
  workflowInstance   DocumentWorkflowInstance @relation(fields: [workflowInstanceId], references: [id])
  stepNumber         Int
  roleId             String?
  userId             String?
  user               User?                    @relation(fields: [userId], references: [id])
  status             String                   @default("PENDING")
  comment            String?
  actionedAt        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
}

model DocumentSignature {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  signatureX Float?
  signatureY Float?
  pageNumber Int?
  signedAt   DateTime @default(now())
}

model DocumentPublication {
  id           String   @id @default(uuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id])
  publishedBy  String
  channel      String   @default("INTERNAL")
  shareUrl     String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  action         String
  module         String
  entityId       String?
  oldValue       Json?
  newValue       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())
}

model UserBiometric {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  deviceId  String
  tokenHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, deviceId])
}

model DpsMember {
  id                 String   @id @default(uuid())
  status             String   // 'Calon DPS' | 'Aktif' | 'Nonaktif'
  jenisPenugasan     String   // 'Penuh Waktu' | 'Paruh Waktu'
  tanggalPengajuan   String
  namaLengkap        String
  fotoUrl            String?
  tempatLahir        String
  tanggalLahir       String
  jenisKelamin       String
  kewarganegaraan    String
  agama              String
  npwp               String
  alamatDomisili     String
  rtRw               String
  kelurahan          String
  kecamatan          String
  kotaKabupaten      String
  provinsi           String
  kodePos            String
  noTelepon          String
  noHp               String
  email              String
  pendidikanTerakhir String
  perguruanTinggi    String
  tahunLulus         String

  // Tab 2 fields
  lembagaPenempatan  String?
  jabatanDps         String?
  skPengangkatan     String?
  tanggalSk          String?
  masaJabatanMulai   String?
  masaJabatanSelesai String?
  riwayatJabatan     Json?    // Array of { lembaga, jabatan, periode }

  // Tab 3 fields
  sertifikatPelatihan Json?   // Array of { nama, lembaga, tahun }
  bidangKeahlian     Json?    // Array of strings
  pengalamanProfesional String?

  // Tab 4 fields
  dokumenFiles       Json?    // Array of { tipe, namaFile }

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model DisposisiLog {
  id                String                   @id @default(uuid())
  documentId        String
  document          Document                 @relation(fields: [documentId], references: [id])
  userId            String?
  user              User?                    @relation(fields: [userId], references: [id])
  action            String
  description       String?
  metadata          Json?
  createdAt         DateTime                 @default(now())
}

model Fatwa {
  id           String   @id @default(uuid())
  title        String
  agendaNumber String   @unique
  status       String   // 'PERMOHONAN' | 'KAJIAN' | 'BPH' | 'PLENO' | 'TTE' | 'PUBLIKASI'
  applicant    String   // Pengaju / Pihak terkait
  tanggal      DateTime @default(now())
  keterangan   String?  // Catatan / Deskripsi fatwa
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Meeting {
  id             String   @id @default(uuid())
  title          String
  agendaNumber   String?  @unique
  dateTime       DateTime
  endDateTime    DateTime?
  location       String
  description    String?
  targetType     String   // 'ALL' | 'EXECUTIVE' | 'ALL_BOARD' | 'SECRETARIAT' | 'FINANCE' | 'DEPARTMENT' | 'CROSS_AGENCY' | 'CROSS_INTERNAL'
  departmentId   String?
  status         String   @default("DRAFT") // 'DRAFT' | 'SELESAI' | 'BATAL' | 'ARSIP'
  attendees      Json     // Array of attendees: [{ userId, name, email, department, jabatan, isExternal, status }]
  invitationSent Boolean  @default(false)
  documentId     String?
  document       Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  discussedDocs  Document[] @relation("MeetingDiscussedDocs")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ── Letter Template Model ────────────────────────────────────────────────────
model LetterTemplate {
  id           String   @id @default(uuid())
  name         String
  code         String?  @unique // e.g., "PKS-SYARIAH", "OPINI-SYARIAH"
  category     String   // e.g., "Pernyataan", "Opini", "Perjanjian"
  description  String?
  // HTML template with {{variable}} placeholders
  htmlContent  String   @db.Text
  // JSON array of variable definitions: [{ key, label, type, required, defaultValue? }]
  variables    Json
  isArchived   Boolean  @default(false)
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Notula {
  id            String   @id @default(uuid())
  meetingId     String?  @unique
  title         String
  agendaNumber  String?
  dateTime      DateTime
  location      String
  content       String?  // Isi risalah / pembahasan rapat (opsional jika upload file)
  fileUrl       String?  // Path/URL file hasil rapat (opsional)
  fileName      String?  // Nama file hasil rapat (opsional)
  decisions     String?  // Keputusan yang diambil (opsional)
  notes         String?  // Catatan tambahan (opsional)
  creatorId     String
  creatorName   String
  attendees     Json     // Menyalin daftar peserta rapat beserta status hadirnya: [{ userId, name, email, department, jabatan, isExternal, status }]
  sharedWithIds Json     // Array user ID untuk pengguna yang dibagikan akses: string[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model EvidenceFolder {
  id         String           @id @default(uuid())
  name       String
  documentId String
  document   Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  parentId   String?
  parent     EvidenceFolder?  @relation("FolderHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children   EvidenceFolder[] @relation("FolderHierarchy")
  files      EvidenceFile[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
}

model EvidenceFile {
  id         String          @id @default(uuid())
  name       String
  fileUrl    String
  fileSize   Int
  mimeType   String
  folderId   String?
  folder     EvidenceFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  documentId String
  document   Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploaderId String?
  uploader   User?           @relation(fields: [uploaderId], references: [id])
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
}

// ── PUBLIC PORTAL MODELS ───────────────────────────────────────────────────

model Company {
  id              String             @id @default(uuid())
  name            String
  legalType       String?            // PT, CV, Yayasan, Koperasi, BUMN, dll
  legalityNumber  String?            // NIB / Nomor Akta
  npwp            String?
  address         String?
  province        String?
  city            String?
  postalCode      String?
  phone           String?
  email           String?
  website         String?
  logoUrl         String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  users           CompanyUser[]
  submissions     PublicSubmission[]
  certificates    ShariaCertificate[]
  notifications   PublicNotification[]
}

model CompanyUser {
  id          String             @id @default(uuid())
  companyId   String
  company     Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  email       String
  fullName    String
  phone       String?
  position    String?            // Jabatan PIC
  role        String             @default("ADMIN") // ADMIN, PIC, USER
  isActive    Boolean            @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  submissions PublicSubmission[]
}

model PublicOtp {
  id        String   @id @default(uuid())
  email     String
  otpHash   String
  type      String   @default("LOGIN") // LOGIN, REGISTER, VERIFY
  attempts  Int      @default(0)
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SubmissionTypeMaster {
  id           String                        @id @default(uuid())
  code         String                        @unique
  name         String
  description  String?
  icon         String?
  sortOrder    Int                           @default(0)
  isActive     Boolean                       @default(true)
  createdAt    DateTime                      @default(now())
  updatedAt    DateTime                      @updatedAt
  requirements SubmissionRequirementMaster[]
  submissions  PublicSubmission[]
}

model SubmissionRequirementMaster {
  id               String               @id @default(uuid())
  submissionTypeId String
  submissionType   SubmissionTypeMaster @relation(fields: [submissionTypeId], references: [id], onDelete: Cascade)
  code             String
  name             String
  description      String?
  isMandatory      Boolean              @default(true)
  allowedFileTypes String               @default("PDF,DOCX,JPG,PNG")
  maxFileSizeMb    Int                  @default(20)
  sortOrder        Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model PublicSubmission {
  id                    String                     @id @default(uuid())
  submissionNumber      String                     @unique // AMN-2026-000001
  companyId             String
  company               Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  applicantUserId       String
  applicantUser         CompanyUser                @relation(fields: [applicantUserId], references: [id])
  submissionTypeId      String?
  submissionType        SubmissionTypeMaster?      @relation(fields: [submissionTypeId], references: [id])
  submissionTypeName    String
  title                 String
  productOrServiceName  String?
  description           String?
  companyLetterNumber   String?
  companyLetterDate     DateTime?
  officialLetterUrl     String?
  officialLetterName    String?
  officialLetterSize    Int?
  status                String                     @default("DRAFT") // DRAFT, SUBMITTED, VERIFIKASI_ADMINISTRASI, PERLU_PERBAIKAN, SEDANG_DIPROSES, DALAM_PEMBAHASAN, PROSES_KEPUTUSAN, DISETUJUI, SERTIFIKAT_DITERBITKAN, SELESAI, DITOLAK
  stepCompleted         Int                        @default(1)
  submittedAt           DateTime?
  erpDocumentId         String?
  erpDocument           Document?                  @relation(fields: [erpDocumentId], references: [id])
  documents             PublicSubmissionDocument[]
  timeline              PublicSubmissionActivity[]
  revisions             PublicSubmissionRevision[]
  certificate           ShariaCertificate?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
}

model PublicSubmissionDocument {
  id                  String           @id @default(uuid())
  submissionId        String
  submission          PublicSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  requirementMasterId String?
  requirementName     String
  fileName            String
  fileUrl             String
  fileSize            Int
  mimeType            String
  isMandatory         Boolean          @default(false)
  status              String           @default("VALID") // VALID, REVISION_REQUIRED, REPLACED
  notes               String?
  uploadedAt          DateTime         @default(now())
}

model PublicSubmissionActivity {
  id              String           @id @default(uuid())
  submissionId    String
  submission      PublicSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  publicStatus    String
  visibility      String           @default("PUBLIC") // PUBLIC, INTERNAL
  performedByName String?
  createdAt       DateTime         @default(now())
}

model PublicSubmissionRevision {
  id                 String           @id @default(uuid())
  submissionId       String
  submission         PublicSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  requestNotes       String
  requestedDocuments Json?
  deadline           DateTime?
  status             String           @default("PENDING") // PENDING, RESPONDED, RESOLVED
  responseNotes      String?
  requestedAt        DateTime         @default(now())
  respondedAt        DateTime?
}

model ShariaCertificate {
  id                   String           @id @default(uuid())
  submissionId         String           @unique
  submission           PublicSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  companyId            String
  company              Company          @relation(fields: [companyId], references: [id])
  certificateNumber    String           @unique // e.g. "DSN-MUI/KS/2026/0018"
  title                String
  issueDate            DateTime
  validUntil           DateTime
  fileUrl              String
  fileName             String
  fileSize             Int
  qrCode               String?
  digitalSignatureInfo Json?
  downloadCount        Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
}

model PublicNotification {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?
  title     String
  message   String
  type      String   @default("INFO") // INFO, SUCCESS, WARNING, ACTION_REQUIRED
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PublicAuditLog {
  id         String   @id @default(uuid())
  companyId  String?
  userId     String?
  action     String
  resource   String
  resourceId String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())
}

