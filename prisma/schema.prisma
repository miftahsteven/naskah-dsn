generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                String             @id @default(uuid())
  name              String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  users             User[]
  organizationUnits OrganizationUnit[]
  documents         Document[]
  auditLogs         AuditLog[]
}

model OrganizationUnit {
  id             String       @id @default(uuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  users          User[]
  documents      Document[]
}

// ── NEW: Department Reference Table ─────────────────────────────────────────
model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

// ── NEW: Jabatan (Position) Reference Table ──────────────────────────────────
model Jabatan {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  User            User[]
}

model Permission {
  id              String           @id @default(uuid())
  code            String           @unique
  name            String
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  passwordHash     String
  fullName         String
  jobTitle         String?
  phone            String?           // ── NEW
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id])
  unitId           String?
  unit             OrganizationUnit? @relation(fields: [unitId], references: [id])
  departmentId     String?           // ── NEW
  department       Department?       @relation(fields: [departmentId], references: [id])
  jabatanId        String?           // ── NEW
  jabatan          Jabatan?          @relation(fields: [jabatanId], references: [id])
  roleId           String
  role             Role              @relation(fields: [roleId], references: [id])
  userRoles        UserRole[]
  isActive         Boolean           @default(true)
  twoFactorEnabled Boolean           @default(false)
  twoFactorSecret  String?
  pinHash          String?
  pushToken        String?           // ── NEW: For Push Notifications
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  documentsCreated Document[]        @relation("DocumentCreator")
  workflowSteps    DocumentWorkflowStep[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  signatures       DocumentSignature[]
  biometrics       UserBiometric[]
  disposisiLogs    DisposisiLog[]
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  roleId    String
  role      Role     @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
}

model DocumentCategory {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  documents Document[]
}

model DocumentClassification {
  id        String     @id @default(uuid())
  level     String     @unique
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  documents Document[]
}

model Document {
  id                String                   @id @default(uuid())
  title             String
  documentNumber    String?                  @unique
  organizationId    String
  organization      Organization             @relation(fields: [organizationId], references: [id])
  unitId            String?
  unit              OrganizationUnit?        @relation(fields: [unitId], references: [id])
  categoryId        String
  category          DocumentCategory         @relation(fields: [categoryId], references: [id])
  classificationId  String
  classification    DocumentClassification   @relation(fields: [classificationId], references: [id])
  creatorId         String
  creator           User                     @relation("DocumentCreator", fields: [creatorId], references: [id])
  documentType      String                   @default("OUTGOING")
  approvalFlowType  String                   @default("SEQUENTIAL")
  certificateUrl    String?
  status            String                   @default("DRAFT")
  disposisiStatus   String?                  // "BARU", "DIPROSES", "SELESAI"
  currentVersion    Int                      @default(1)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  versions          DocumentVersion[]
  workflowInstances DocumentWorkflowInstance[]
  signatures        DocumentSignature[]
  publications      DocumentPublication[]
  disposisiLogs     DisposisiLog[]
}

model DocumentVersion {
  id          String   @id @default(uuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id])
  versionNum  Int
  fileUrl     String
  fileName    String
  fileSize    Int
  mimeType    String
  changeNotes String?
  createdAt   DateTime @default(now())
  createdBy   String

  @@unique([documentId, versionNum])
}

model WorkflowTemplate {
  id                String                     @id @default(uuid())
  name              String
  description       String?
  organizationId    String
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  steps             Json
  workflowInstances DocumentWorkflowInstance[]
}

model DocumentWorkflowInstance {
  id            String                 @id @default(uuid())
  documentId    String
  document      Document               @relation(fields: [documentId], references: [id])
  templateId    String?
  template      WorkflowTemplate?      @relation(fields: [templateId], references: [id])
  status        String                 @default("ACTIVE")
  currentStep   Int                    @default(1)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  steps         DocumentWorkflowStep[]
}

model DocumentWorkflowStep {
  id                 String                   @id @default(uuid())
  workflowInstanceId String
  workflowInstance   DocumentWorkflowInstance @relation(fields: [workflowInstanceId], references: [id])
  stepNumber         Int
  roleId             String?
  userId             String?
  user               User?                    @relation(fields: [userId], references: [id])
  status             String                   @default("PENDING")
  comment            String?
  actionedAt        DateTime?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
}

model DocumentSignature {
  id         String   @id @default(uuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  signatureX Float?
  signatureY Float?
  pageNumber Int?
  signedAt   DateTime @default(now())
}

model DocumentPublication {
  id           String   @id @default(uuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id])
  publishedBy  String
  channel      String   @default("INTERNAL")
  shareUrl     String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  user           User?        @relation(fields: [userId], references: [id])
  action         String
  module         String
  entityId       String?
  oldValue       Json?
  newValue       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())
}

model UserBiometric {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  deviceId  String
  tokenHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, deviceId])
}

model DpsMember {
  id                 String   @id @default(uuid())
  status             String   // 'Calon DPS' | 'Aktif' | 'Nonaktif'
  jenisPenugasan     String   // 'Penuh Waktu' | 'Paruh Waktu'
  tanggalPengajuan   String
  namaLengkap        String
  fotoUrl            String?
  tempatLahir        String
  tanggalLahir       String
  jenisKelamin       String
  kewarganegaraan    String
  agama              String
  npwp               String
  alamatDomisili     String
  rtRw               String
  kelurahan          String
  kecamatan          String
  kotaKabupaten      String
  provinsi           String
  kodePos            String
  noTelepon          String
  noHp               String
  email              String
  pendidikanTerakhir String
  perguruanTinggi    String
  tahunLulus         String

  // Tab 2 fields
  lembagaPenempatan  String?
  jabatanDps         String?
  skPengangkatan     String?
  tanggalSk          String?
  masaJabatanMulai   String?
  masaJabatanSelesai String?
  riwayatJabatan     Json?    // Array of { lembaga, jabatan, periode }

  // Tab 3 fields
  sertifikatPelatihan Json?   // Array of { nama, lembaga, tahun }
  bidangKeahlian     Json?    // Array of strings
  pengalamanProfesional String?

  // Tab 4 fields
  dokumenFiles       Json?    // Array of { tipe, namaFile }

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model DisposisiLog {
  id                String                   @id @default(uuid())
  documentId        String
  document          Document                 @relation(fields: [documentId], references: [id])
  userId            String?
  user              User?                    @relation(fields: [userId], references: [id])
  action            String
  description       String?
  metadata          Json?
  createdAt         DateTime                 @default(now())
}

model Fatwa {
  id           String   @id @default(uuid())
  title        String
  agendaNumber String   @unique
  status       String   // 'PERMOHONAN' | 'KAJIAN' | 'BPH' | 'PLENO' | 'TTE' | 'PUBLIKASI'
  applicant    String   // Pengaju / Pihak terkait
  tanggal      DateTime @default(now())
  keterangan   String?  // Catatan / Deskripsi fatwa
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Meeting {
  id             String   @id @default(uuid())
  title          String
  agendaNumber   String?  @unique
  dateTime       DateTime
  endDateTime    DateTime?
  location       String
  description    String?
  targetType     String   // 'ALL' | 'EXECUTIVE' | 'ALL_BOARD' | 'SECRETARIAT' | 'FINANCE' | 'DEPARTMENT' | 'CROSS_AGENCY' | 'CROSS_INTERNAL'
  departmentId   String?
  status         String   @default("DRAFT") // 'DRAFT' | 'SELESAI' | 'BATAL' | 'ARSIP'
  attendees      Json     // Array of attendees: [{ userId, name, email, department, jabatan, isExternal, status }]
  invitationSent Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ── Letter Template Model ────────────────────────────────────────────────────
model LetterTemplate {
  id           String   @id @default(uuid())
  name         String
  code         String?  @unique // e.g., "PKS-SYARIAH", "OPINI-SYARIAH"
  category     String   // e.g., "Pernyataan", "Opini", "Perjanjian"
  description  String?
  // HTML template with {{variable}} placeholders
  htmlContent  String   @db.Text
  // JSON array of variable definitions: [{ key, label, type, required, defaultValue? }]
  variables    Json
  isArchived   Boolean  @default(false)
  createdBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Notula {
  id            String   @id @default(uuid())
  meetingId     String?  @unique
  title         String
  agendaNumber  String?
  dateTime      DateTime
  location      String
  content       String   // Isi risalah / pembahasan rapat
  decisions     String?  // Keputusan yang diambil (opsional)
  notes         String?  // Catatan tambahan (opsional)
  creatorId     String
  creatorName   String
  attendees     Json     // Menyalin daftar peserta rapat beserta status hadirnya: [{ userId, name, email, department, jabatan, isExternal, status }]
  sharedWithIds Json     // Array user ID untuk pengguna yang dibagikan akses: string[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

